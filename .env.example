# Backend server config
PORT=8787

# ── Anthropic (cloud AI) ──────────────────────────────────────────────────────
# Add your real key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# ── Ollama (local AI — higher priority than Anthropic when running) ───────────
# Install: https://ollama.com  |  Then run: ollama run llama3.1
# Leave default unless Ollama is on a different host/port
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional: comma-separated allowlist for browser origins in development
FRONTEND_ORIGIN=http://localhost:5173
