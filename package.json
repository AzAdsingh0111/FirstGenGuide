{
  "name": "firstgen-guide-root",
  "private": true,
  "type": "module",
  "workspaces": [
    "firstgen-guide"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev -w firstgen-guide --",
    "dev:server": "node server/index.js",
    "build": "npm run build -w firstgen-guide --",
    "preview": "npm run preview -w firstgen-guide --",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
